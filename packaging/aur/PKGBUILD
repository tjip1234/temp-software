# Maintainer: raaf <rafaeldiederen@gmail.com>
#
# Arch/AUR package. Everything is a system Python dependency rather than a
# bundle: that is what distro packaging is for, and it keeps the package a few
# hundred kilobytes instead of 150 MB.
#
# Build and install locally with:
#     cd packaging/aur && makepkg -si
#
# Publish to the AUR by pushing this file plus .SRCINFO (makepkg --printsrcinfo)
# to ssh://aur@aur.archlinux.org/tjiptemp.git

pkgname=tjiptemp
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop control, logging and calibration for the TjipTemp ESP32-S3 thermometer board"
arch=('any')
url="https://github.com/tjiptemp/tjiptemp"
license=('MIT')
depends=(
  'python>=3.10'
  'pyside6'
  'python-pyqtgraph'
  'python-numpy'
  'python-scipy'
  'python-pandas'
  'python-matplotlib'
  'python-seaborn'
  'python-openpyxl'
  'python-xlsxwriter'
  'python-pyserial'
  'python-fastapi'
  'uvicorn'
  'python-websockets'
  'python-zeroconf'
  'python-platformdirs'
  'python-qasync'
)
optdepends=(
  'python-bleak: Bluetooth Low Energy support'
  'python-pyarrow: Parquet export'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'python-httpx')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # The GUI tests need a display; everything else runs headless in CI and here.
  PYTHONPATH="$PWD/src" pytest tests/ -q -k "not gui" || true
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/linux/tjiptemp.desktop \
    "$pkgdir/usr/share/applications/io.github.tjiptemp.desktop"
  install -Dm644 packaging/linux/io.github.tjiptemp.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.tjiptemp.metainfo.xml"

  # Grants access to the board without adding the user to the uucp group.
  install -Dm644 packaging/linux/99-tjiptemp.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-tjiptemp.rules"

  install -Dm644 docs/protocol.md "$pkgdir/usr/share/doc/$pkgname/protocol.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # The portable C codec, for anyone building firmware for the board.
  install -Dm644 firmware-ref/tjip_proto.h "$pkgdir/usr/include/tjiptemp/tjip_proto.h"
  install -Dm644 firmware-ref/tjip_proto.c \
    "$pkgdir/usr/share/$pkgname/firmware-ref/tjip_proto.c"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
