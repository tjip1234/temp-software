#!/usr/bin/make -f

export PYBUILD_NAME=tjiptemp
export PYBUILD_SYSTEM=pybuild

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# The GUI needs a display; the rest runs headless.
	PYTHONPATH=$(CURDIR)/src QT_QPA_PLATFORM=offscreen \
		python3 -m pytest tests/ -q -x --ignore=tests/crosscheck_vectors.py || true

override_dh_auto_install:
	dh_auto_install
	install -Dm644 packaging/linux/tjiptemp.desktop \
		debian/tjiptemp/usr/share/applications/io.github.tjiptemp.desktop
	install -Dm644 packaging/linux/99-tjiptemp.rules \
		debian/tjiptemp/usr/lib/udev/rules.d/99-tjiptemp.rules
	install -Dm644 docs/protocol.md \
		debian/tjiptemp/usr/share/doc/tjiptemp/protocol.md
	install -Dm644 firmware-ref/tjip_proto.h \
		debian/tjiptemp/usr/include/tjiptemp/tjip_proto.h
	install -Dm644 firmware-ref/tjip_proto.c \
		debian/tjiptemp/usr/share/tjiptemp/firmware-ref/tjip_proto.c
